# ==============================================================================
# [Aiuto-v2] 환경 변수 템플릿 (.env.example)
# app/core/config.py의 Settings 클래스와 1:1로 대응하는 실제 사용 변수 목록입니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & JWT Authentication
# ------------------------------------------------------------------------------
# 필수: openssl rand -hex 32 등으로 생성한 최소 32바이트 이상 보안 비밀키
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
# 토큰 만료 시간 (분 단위, 코드 기본값: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database
# (주의: DATABASE_URL은 아래 5개 필드를 조합하여 코드가 자동 생성합니다)
# ------------------------------------------------------------------------------
POSTGRES_USER="Aiuto_v2_admin"
POSTGRES_PASSWORD="your-secure-postgres-password"
POSTGRES_DB="Aiuto_v2"
POSTGRES_HOST="localhost"              # Docker 환경 외부 실행 시 localhost, 내부 통신 시 "postgres"
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis (Celery Broker & Result Backend)
# (주의: Celery 연결 URL은 아래 3개 필드를 조합하여 코드가 자동 생성합니다)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"                 # Docker 환경 외부 실행 시 localhost, 내부 통신 시 "redis"
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. LLM Providers & Pipeline Chain
# ------------------------------------------------------------------------------
# LLM 실행 순서 및 프로바이더 지정 (기본값: gemini 단일 체인)
LLM_CHAIN="gemini:gemini-3.5-flash-lite"

# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# NVIDIA NIM API Key (V3 이연 / 폴백 확장용)
NVIDIA_API_KEY="your-nvidia-nim-api-key-here"